APP_ENV=development
APP_NAME=VANTIQ API
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://vantiq:vantiq_local_only@db:5432/vantiq
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_MINUTES=60

# Local development defaults to a deterministic mock. Production must select a real provider.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Optional SMTP settings for password-reset email delivery. Keep credentials in Railway variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
