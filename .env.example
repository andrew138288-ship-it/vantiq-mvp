APP_ENV=development
APP_NAME=VANTIQ API
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://vantiq:vantiq_local_only@db:5432/vantiq
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_MINUTES=60
# Configure the AI Gateway locally. Never commit a real API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
