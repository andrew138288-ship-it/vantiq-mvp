{
  "name": "vantiq-whatsapp-dock",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:content": "vite build --config vite.content.config.ts",
    "build:worker": "vite build --config vite.worker.config.ts",
    "build": "npm run typecheck && npm run build:content && npm run build:worker && node scripts/copy-manifest.mjs",
    "test": "npm run typecheck && tsc -p tsconfig.test.json && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "@types/chrome": "0.3.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
